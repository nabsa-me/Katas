{
  "name": "poc-to-production",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "bot": "node --env-file-if-exists=.env --import tsx src/exercises/hardening-a-poc/main.ts",
    "demo": "tsx src/exercises/hardening-a-poc/demo.ts",
    "demo:problem": "tsx src/exercises/hardening-a-poc/demo.ts problem"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "msw": "^3.0.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "description": "Solved kata on taking a proof of concept to production: configuration, secrets, ports and adapters, logging, errors, retries and tests",
  "engines": {
    "node": ">=22.12"
  }
}
