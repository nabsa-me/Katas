# Real mode: copy to .env (never committed) and run `npm run bot`.
# The values below are placeholders; the bot refuses to start while any secret still has one.

# Jira Cloud site and an API token of the account the bot uses (id.atlassian.com > Security > API tokens).
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=digest-bot@example.com
JIRA_API_TOKEN=replace-with-a-jira-api-token
JIRA_PROJECT_KEY=PLAT

# Slack app bot token with the chat:write scope, and the id of a channel the app has been added to.
SLACK_BOT_TOKEN=replace-with-a-slack-bot-token
SLACK_CHANNEL_ID=C0123456789

# Optional.
REQUEST_TIMEOUT_MS=10000
LOG_LEVEL=info
