# Optional: every variable has a local default, so `npm start` works without a .env file.
# To change one, copy this file to .env (never committed); `npm start` reads it.

# Where the service listens. 127.0.0.1 keeps it on this machine; 0.0.0.0 opens it to other hosts and containers.
PORT=5808
HOST=127.0.0.1

# The Postgres from docker-compose.yml. Local-only credentials of a throwaway container.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5809/production_health

LOG_LEVEL=info
READINESS_TIMEOUT_MS=1000
# After SIGTERM: how long /readyz fails while requests are still served, so the load balancer stops routing first.
DRAIN_DELAY_MS=0

# Sentry: empty disables it. The DSN is in the Sentry project settings, under Client Keys (DSN).
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
