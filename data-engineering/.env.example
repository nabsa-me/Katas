# Optional real mode for the incremental Jira extractor: copy to .env and replace every value.
# Run: uv run --env-file .env python -m exercises.incremental_jira_extractor.extractor
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=replace-with-an-api-token
JIRA_JQL_FILTER="project in (PAY, WAL)"
DATABASE_URL=postgresql://postgres:postgres@localhost:5810/postgres
DATABASE_SCHEMA=raw
