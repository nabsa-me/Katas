# Real mode is optional: copy to .env (never committed). Every test runs without it, against mocks.

# Claude via Amazon Bedrock (npm run ask). AWS credentials come from the default chain:
# an SSO profile (AWS_PROFILE), environment variables, or a container or instance role. Never put keys here.
AWS_REGION=us-east-1
AWS_PROFILE=replace-with-your-sso-profile
# A model id or an inference profile id. Check which ones your account and Region can use in the Bedrock console.
BEDROCK_MODEL_ID=global.anthropic.claude-opus-5-5
BEDROCK_TIMEOUT_MS=120000
BEDROCK_MAX_ATTEMPTS=3
BEDROCK_MAX_TOKENS=16000
