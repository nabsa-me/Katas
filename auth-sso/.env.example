# Copy to .env.local for `npm run dev` / `npm run start` (Next.js loads it; it is not committed).
# The values below match the local mock provider from docker-compose.yml.

# OpenID Connect provider (issuer URL; discovery is read from <issuer>/.well-known/openid-configuration).
OIDC_ISSUER=http://localhost:5806/katas
# Public client: no client secret, the authorization code is protected with PKCE.
OIDC_CLIENT_ID=katas-web
# Public URL of the app, used to build the redirect and post-logout URIs.
APP_URL=http://localhost:5804
# Signs the session cookie (HS256). At least 32 characters; generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
